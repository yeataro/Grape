+.canvas-notice {
+  top: 92px;
+  left: 12px;
+  right: 12px;
+  pointer-events: none;
+}
+.node-browser {
+  position: absolute;
+  z-index: 20;
+  width: 350px;
+  max-width: calc(100% - 8px);
+  max-height: calc(100% - 8px);
+  display: flex;
+  flex-direction: column;
+  border: 1px solid #60576e;
+  border-radius: 8px;
+  background: var(--panel);
+  box-shadow: 0 12px 36px #0009;
+  overflow: hidden;
+}
+.node-browser header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 9px 12px;
+  cursor: move;
+  user-select: none;
+  background: #282430;
+}
+.node-browser header button {
+  padding: 2px;
+  background: none;
+  border: 0;
+}
+.node-browser input {
+  margin: 10px;
+  width: calc(100% - 20px);
+  padding: 9px;
+  color: inherit;
+  background: #191920;
+  border: 1px solid #51465f;
+  border-radius: 5px;
+}
+.catalog-filters {
+  display: flex;
+  gap: 5px;
+  margin: 0 10px 9px;
+}
+.catalog-filters select {
+  width: 50%;
+  min-width: 0;
+  font-size: 10px;
+}
+.catalog-list {
+  min-height: 80px;
+  overflow: auto;
+  max-height: 320px;
+  padding: 0 8px 8px;
+}
+.catalog-list summary {
+  padding: 8px;
+  font-size: 11px;
+  cursor: pointer;
+}
+.catalog-row {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  border-radius: 4px;
+}
+.catalog-row.current {
+  background: #43345c;
+}
+.catalog-row > button:first-child {
+  flex: 1;
+  align-items: flex-start;
+  flex-direction: column;
+  background: none;
+  border: 0;
+  text-align: left;
+  font-size: 12px;
+  padding: 7px;
+}
+.catalog-row small {
+  font-size: 9px;
+  color: #b6a9c5;
+  padding-top: 3px;
+}
+.catalog-row > button:last-child {
+  padding: 7px;
+  background: none;
+  border: 0;
+}
+.catalog-detail {
+  border-top: 1px solid #51465f;
+  padding: 12px;
+  overflow: auto;
+  max-height: 180px;
+  font-size: 11px;
+}
+.catalog-detail p {
+  white-space: pre-line;
+}
+.catalog-detail pre {
+  white-space: pre-wrap;
+  font-size: 10px;
+}
+.creation-preview {
+  width: 190px;
+  border-radius: 9px;
+  background: var(--node);
+  position: absolute;
+  pointer-events: none;
+  z-index: 9;
+  opacity: 0.75;
+  border: 2px dashed var(--selection);
+}
+.creation-preview h3 {
+  margin: 0 0 7px;
+  padding: 12px 13px;
+  min-height: 41px;
+  font-size: 12px;
+  line-height: 16px;
+  background: #43345c;
+  border-radius: 8px 8px 0 0;
+}
+.node {
+  overflow: visible;
+}
+.creation-preview .port {
+  display: flex;
+}
+.creation-preview .output {
+  justify-content: flex-end;
+}
+.creation-wire {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: 8;
+  pointer-events: none;
+}
+.creation-wire path {
+  fill: none;
+  stroke: var(--accent);
+  stroke-width: 2;
+  stroke-dasharray: 5 4;
+}
+.canvas-menu {
+  position: absolute;
+  z-index: 25;
+  padding: 6px;
+  min-width: 190px;
+  background: #25222e;
+  border: 1px solid #60576e;
+  border-radius: 6px;
+  box-shadow: 0 8px 24px #0009;
+}
+.canvas-menu button {
+  display: flex;
+  width: 100%;
+  min-height: 44px;
+  justify-content: flex-start;
+  background: transparent;
+  border: 0;
+}
+.canvas-menu button:focus {
+  background: #43345c;
+}
+.shortcut-help {
+  max-height: 90vh;
+  padding: 0;
+  width: min(650px, 90vw);
+}
+.shortcut-help h2 {
+  font-size: 18px;
+  padding: 20px;
+  margin: 0;
+}
+.shortcut-grid {
+  display: grid;
+  grid-template-columns: minmax(140px, 1fr) 1.5fr;
+  gap: 16px;
+  padding: 20px;
+  overflow: auto;
+  max-height: 60vh;
+  font-size: 13px;
+  border-block: 1px solid #51465f;
+}
+.shortcut-help > button {
+  margin: 12px 20px;
+}
+* {
+  scrollbar-width: thin;
+  scrollbar-color: #51465f #1b1b23;
+}
+@media (max-width: 900px) {
+  main {
+    grid-template-columns: minmax(0, 1fr) 240px;
+  }
+  .canvas-entry-actions button {
+    font-size: 0;
+    padding: 8px;
+  }
+  .canvas-entry-actions .action-icon {
+    margin: 0;
+  }
+  .brand small {
+    display: none;
+  }
+}
+@media (max-width: 620px) {
+  main {
+    display: block;
+  }
+  .canvas-pane {
+    min-height: 650px;
+  }
+  #inspector {
+    max-height: 340px;
+    overflow: auto;
+  }
+  .brand {
+    font-size: 18px;
+  }
+}
